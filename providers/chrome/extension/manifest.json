{
  "manifest_version": 3,
  "name": "Ambient Context",
  "version": "0.1.0",
  "description": "Lets an assistant on this Mac see the page in front and the text selected on it, when you ask it something.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["nativeMessaging", "scripting", "tabs", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" }
}
